# Pinned development runtime images and loopback-only host ports.
WSO2_APIM_IMAGE=wso2/wso2am:4.7.0
WSO2_APIM_HOME_VERSION=4.7.0
WSO2_IS_HTTPS_PORT=9443
WSO2_APIM_HTTPS_PORT=9444
WSO2_APIM_GATEWAY_HTTPS_PORT=8243
FRONTEND_PORT=3000

# Named volumes. The recovery verifier overrides these with isolated names so
# it never deletes or mutates the normal development environment.
POSTGRES_VOLUME_NAME=securescan-postgres-development-data
IDENTITY_VOLUME_NAME=securescan-identity-server-development-data
APIM_VOLUME_NAME=securescan-api-manager-development-data

# Stable network names used by the topology verifier. Recovery tests override
# these so their empty-stack run is isolated from normal development state.
IDENTITY_NETWORK_NAME=securescan-identity
GATEWAY_NETWORK_NAME=securescan-gateway
INTEGRATION_NETWORK_NAME=securescan-integration
SCANNER_NETWORK_NAME=securescan-scanner
DATA_NETWORK_NAME=securescan-data

# Development-only PostgreSQL defaults. Use a local deployment/.env file to
# override them; that file is ignored and must never be committed.
POSTGRES_DB=securescan_dev
POSTGRES_USER=securescan
POSTGRES_PASSWORD=replace-with-generated-development-password

# Used by apictl to substitute the trusted backend-hop secret into the custom
# request mediation policy. Match Ballerina gatewaySharedSecret.
SECURESCAN_GATEWAY_SHARED_SECRET=replace-with-at-least-32-random-characters

# WSO2 application values used by the server-side Next.js OIDC client.
OIDC_CLIENT_ID=replace-with-wso2-client-id
OIDC_CLIENT_SECRET=replace-with-wso2-client-secret
OIDC_ROLE_CLAIM=groups
OIDC_SCOPES=openid profile email securescan:scan
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters

# Inside Compose, Next.js reaches WSO2 over its service name. A trusted local
# CA mount is completed with the environment hardening work on Day 36.
COMPOSE_OIDC_ISSUER=https://identity-server:9443/oauth2/token
NODE_EXTRA_CA_CERTS=

# Application safety and recovery limits.
MAX_PORTS_PER_SCAN=1000
MAX_CONCURRENT_PORTS=100
MAX_ACTIVE_SCANS=10
MAX_RETAINED_JOBS=1000
SCAN_TIMEOUT_MS=1000
API_MAX_REQUEST_BYTES=4096
API_GATEWAY_TIMEOUT_MS=10000
SCANNER_CONNECT_TIMEOUT_SECONDS=2.0
SCANNER_RESPONSE_TIMEOUT_SECONDS=5.0
DISPATCH_LEASE_SECONDS=15
RECONCILIATION_INTERVAL_SECONDS=5
