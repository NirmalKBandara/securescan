# Same-origin browser path. Next.js proxies this to Ballerina so local browser
# requests do not require a permissive cross-origin policy.
NEXT_PUBLIC_API_BASE_URL=/backend

# Day 28 default: server-side API Manager Gateway context. The browser still
# calls /backend, so the access token remains inside the Next.js server.
API_MANAGER_GATEWAY_URL=https://localhost:8243/securescan/v1
SECURESCAN_API_MODE=gateway

# These may be lowered but cannot exceed the hard security caps.
API_MAX_REQUEST_BYTES=4096
API_GATEWAY_TIMEOUT_MS=10000

# Explicit development fallback only. This value is ignored in gateway mode.
BALLERINA_API_BASE_URL=http://127.0.0.1:9090

# Must match Ballerina's gatewaySharedSecret in direct mode. API Manager must
# inject the same value from its secure configuration in gateway mode.
SECURESCAN_API_GATEWAY_SECRET=replace-with-at-least-32-random-characters

# Browser-visible origin of this Next.js application. WSO2 must register the
# exact callback http://localhost:3000/auth/callback and logout destination
# http://localhost:3000/login for this value.
APP_BASE_URL=http://localhost:3000

# WSO2's issuer is not its console origin. The discovery document is available
# at ${OIDC_ISSUER}/.well-known/openid-configuration.
OIDC_ISSUER=https://localhost:9443/oauth2/token

# Obtain these from the SecureScan Traditional Web Application in WSO2.
# Keep the real values in frontend/.env.local; that file is ignored by Git.
OIDC_CLIENT_ID=replace-with-wso2-client-id
OIDC_CLIENT_SECRET=replace-with-wso2-client-secret

# Claim containing the exact securescan-user / securescan-admin role values.
OIDC_ROLE_CLAIM=groups

# Request the API scope enforced by the published SecureScan API definition.
OIDC_SCOPES=openid profile email securescan:scan

# Generate at least 32 random characters (for example: openssl rand -base64 32).
# This encrypts short-lived OIDC transaction and application session cookies.
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
